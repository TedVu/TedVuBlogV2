<button
  type="button"
  class="theme-toggle"
  data-theme-toggle
  aria-label="Toggle dark mode"
  aria-pressed="false"
>
  <svg
    class="icon-sun"
    viewBox="0 0 24 24"
    width="22"
    height="22"
    aria-hidden="true"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path
      d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"
    ></path>
  </svg>
  <svg
    class="icon-moon"
    viewBox="0 0 24 24"
    width="22"
    height="22"
    aria-hidden="true"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
  </svg>
</button>

<script>
  const root = document.documentElement;

  function syncToggles() {
    const isDark = root.dataset.theme === "dark";
    for (const toggle of document.querySelectorAll("[data-theme-toggle]")) {
      toggle.setAttribute("aria-pressed", String(isDark));
    }
  }

  // Delegated so it keeps working after ClientRouter swaps the header.
  document.addEventListener("click", (event) => {
    const toggle = (event.target as Element).closest("[data-theme-toggle]");
    if (!toggle) return;

    const theme = root.dataset.theme === "dark" ? "light" : "dark";
    root.dataset.theme = theme;
    try {
      localStorage.setItem("theme", theme);
    } catch {
      // Storage blocked: the choice still applies for this session.
    }
  });

  // Covers clicks, OS preference changes and page swaps.
  new MutationObserver(syncToggles).observe(root, {
    attributes: true,
    attributeFilter: ["data-theme"],
  });
  document.addEventListener("astro:page-load", syncToggles);
  syncToggles();
</script>

<style>
  .theme-toggle {
    display: flex;
    align-items: center;
    align-self: center;
    flex-shrink: 0;
    margin-left: auto;
    padding: 0.35em;
    border: none;
    border-radius: 8px;
    background: none;
    color: inherit;
    cursor: pointer;
  }

  .theme-toggle:hover {
    color: var(--accent);
  }

  .theme-toggle:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .icon-moon,
  :global([data-theme="dark"]) .icon-sun {
    display: none;
  }

  :global([data-theme="dark"]) .icon-moon {
    display: block;
  }
</style>
