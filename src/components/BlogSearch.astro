---
interface Post {
  title: string;
  slug: string;
  date: string;
}

interface Props {
  posts: Post[];
}

const { posts } = Astro.props;
---

<div>
  <input
    id="search-input"
    type="search"
    placeholder="Search posts..."
    aria-label="Search posts"
  />

  <ul id="post-list">
    {
      posts.map((post) => (
        <li data-post-slug={post.slug}>
          <a href={`/blog/${post.slug}/`}>
            <h2>{post.title}</h2>
            <time>{post.date}</time>
          </a>
        </li>
      ))
    }
  </ul>

  <p id="no-results" hidden>No posts found</p>
  <p id="search-error" role="alert" hidden>
    Search is unavailable right now. Showing all posts.
  </p>
</div>

<script>
  import { getSearchEngine, searchPosts } from "../utilities/search-engine";

  document.addEventListener('astro:page-load', () => {
  const input =
    document.querySelector<HTMLInputElement>("#search-input");

  const postElements = Array.from(
    document.querySelectorAll<HTMLElement>("[data-post-slug]")
  );

  const noResults =
    document.querySelector<HTMLElement>("#no-results");

  const searchError =
    document.querySelector<HTMLElement>("#search-error");

  function debounce<T extends (...args: any[]) => void>(
    callback: T,
    delay: number
  ) {
    let timeoutId: ReturnType<typeof setTimeout>;

    return (...args: Parameters<T>) => {
      clearTimeout(timeoutId);

      timeoutId = setTimeout(() => {
        callback(...args);
      }, delay);
    };
  }

  if (input && noResults && searchError) {
    function showAllPosts() {
      for (const element of postElements) {
        element.hidden = false;
      }

      noResults!.hidden = true;
    }

    // Loading the index is awaited inside the handler, so a slow first load
    // could otherwise let an earlier keystroke overwrite a later one.
    let latestRequestId = 0;

    const handleSearch = debounce(async (query: string) => {
      const requestId = ++latestRequestId;
      const normalizedQuery = query.trim();

      if (!normalizedQuery) {
        showAllPosts();
        return;
      }

      let fuse;

      try {
        fuse = await getSearchEngine();
      } catch (error) {
        console.error("Failed to load the search index:", error);

        if (requestId === latestRequestId) {
          searchError!.hidden = false;
          showAllPosts();
        }

        return;
      }

      if (requestId !== latestRequestId) {
        return;
      }

      searchError!.hidden = true;

      const matchingSlugs = new Set(
        searchPosts(fuse, normalizedQuery).map((post) => post.slug)
      );

      let visibleCount = 0;

      for (const element of postElements) {
        const slug = element.dataset.postSlug;
        const isMatch = Boolean(
          slug && matchingSlugs.has(slug)
        );

        element.hidden = !isMatch;

        if (isMatch) {
          visibleCount++;
        }
      }

      noResults!.hidden = visibleCount > 0;
    }, 250);

    input.addEventListener("input", () => {
      handleSearch(input.value);
    });

    // Warm the index on first intent so the first search doesn't pay for it.
    input.addEventListener(
      "focus",
      () => {
        getSearchEngine().catch(() => {
          /* Reported when a search actually runs. */
        });
      },
      { once: true }
    );
  }
});
</script>

<style>
  #search-input {
    width: 100%;
    padding: 0.6em 1em;
    margin-bottom: 2em;
    border: 2px solid rgba(0, 0, 0, 0.15);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.6);
    font-size: 1rem;
    outline: none;
    transition: border-color 0.2s;
    -webkit-appearance: none;
  }

  #search-input:focus {
    border-color: #2337ff;
  }

  ul {
    list-style-type: none;
    padding: 0;
    margin: 0;
  }

  ul li {
    margin-bottom: 2em;
  }

  ul li * {
    text-decoration: none;
    transition: 0.2s ease;
  }

  time {
    color: grey;
  }

  #search-error {
    color: #8a1c1c;
  }
</style>
