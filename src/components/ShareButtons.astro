---
interface Props {
  /** The post's canonical URL (same value as og:url). */
  url: string;
  title: string;
  position?: "top" | "bottom";
}

const { url, title, position = "bottom" } = Astro.props;

const u = encodeURIComponent(url);
const t = encodeURIComponent(title);

const links = [
  {
    label: "Share on Facebook",
    href: `https://www.facebook.com/sharer/sharer.php?u=${u}`,
    icon: "facebook",
  },
  {
    label: "Share on X",
    href: `https://x.com/intent/post?url=${u}&text=${t}`,
    icon: "x",
  },
  {
    label: "Share on WhatsApp",
    href: `https://wa.me/?text=${t}%20${u}`,
    icon: "whatsapp",
  },
] as const;
---

<div class:list={["share", position]} data-share>
  {
    links.map(({ label, href, icon }) => (
      <a
        class="share-btn"
        href={href}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={label}
        title={label}
      >
        {icon === "facebook" && (
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" class="filled">
            <path d="M13.5 22v-8.2h2.8l.4-3.3h-3.2V8.4c0-.9.3-1.6 1.6-1.6h1.7V3.9c-.3 0-1.3-.1-2.5-.1-2.5 0-4.2 1.5-4.2 4.3v2.4H7.3v3.3h2.8V22h3.4z" />
          </svg>
        )}
        {icon === "x" && (
          <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" class="filled">
            <path d="M18.9 1.15h3.68l-8.04 9.19L24 22.85h-7.41l-5.8-7.58-6.64 7.58H.47l8.6-9.83L0 1.15h7.59l5.24 6.93zm-1.29 19.5h2.04L6.49 3.24H4.3z" />
          </svg>
        )}
        {icon === "whatsapp" && (
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" class="filled">
            <path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.16-.17.2-.35.22-.64.08-.3-.15-1.26-.46-2.39-1.48-.88-.79-1.48-1.76-1.65-2.06-.17-.3-.02-.46.13-.6.13-.14.3-.35.45-.52.15-.18.2-.3.3-.5.1-.2.05-.37-.03-.52-.07-.15-.67-1.61-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.88 1.21 3.07c.15.2 2.1 3.2 5.08 4.49.71.3 1.26.49 1.7.62.71.23 1.36.2 1.87.12.57-.09 1.76-.72 2-1.41.25-.7.25-1.29.18-1.41-.08-.13-.27-.2-.57-.35zm-5.42 7.4h-.01a9.87 9.87 0 0 1-5.03-1.37l-.36-.22-3.74.99 1-3.65-.24-.37a9.86 9.86 0 0 1-1.51-5.26c0-5.45 4.44-9.88 9.89-9.88 2.64 0 5.12 1.03 6.99 2.9a9.83 9.83 0 0 1 2.89 7c0 5.45-4.44 9.88-9.88 9.88zm8.41-18.3A11.82 11.82 0 0 0 12.05 0C5.5 0 .16 5.34.16 11.89c0 2.1.55 4.14 1.59 5.95L.06 24l6.3-1.65a11.88 11.88 0 0 0 5.68 1.45h.01c6.55 0 11.89-5.34 11.89-11.9 0-3.17-1.24-6.16-3.48-8.4z" />
          </svg>
        )}
      </a>
    ))
  }
  <button
    type="button"
    class="share-btn copy"
    data-share-copy
    data-url={url}
    data-title={title}
    aria-label="Copy link"
    title="Copy link"
  >
    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" class="stroked">
      <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" />
      <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" />
    </svg>
    <span class="copied-text" data-share-copied hidden>Copied</span>
  </button>
  <button
    type="button"
    class="share-btn"
    data-share-native
    data-url={url}
    data-title={title}
    aria-label="Share via…"
    title="Share via…"
    hidden
  >
    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" class="stroked">
      <circle cx="18" cy="5" r="3" />
      <circle cx="6" cy="12" r="3" />
      <circle cx="18" cy="19" r="3" />
      <path d="M8.59 13.51l6.83 3.98M15.41 6.51l-6.82 3.98" />
    </svg>
  </button>
  <span class="sr-only" aria-live="polite" data-share-status></span>
</div>

<script>
  const COPIED_MS = 2000;
  const resetTimers = new WeakMap<Element, number>();

  function showCopied(root: Element) {
    const copied = root.querySelector<HTMLElement>("[data-share-copied]");
    const status = root.querySelector<HTMLElement>("[data-share-status]");
    if (copied) copied.hidden = false;
    if (status) status.textContent = "Link copied";

    window.clearTimeout(resetTimers.get(root));
    resetTimers.set(
      root,
      window.setTimeout(() => {
        if (copied) copied.hidden = true;
        if (status) status.textContent = "";
      }, COPIED_MS),
    );
  }

  async function copyLink(root: Element, url: string) {
    try {
      if (!navigator.clipboard) throw new Error("Clipboard API unavailable");
      await navigator.clipboard.writeText(url);
    } catch {
      // Insecure context or permission denied: let the reader copy by hand.
      window.prompt("Copy this link:", url);
      return;
    }
    showCopied(root);
  }

  // One delegated listener: correct for both instances on a page and after
  // every ClientRouter swap, and never bound twice.
  document.addEventListener("click", async (event) => {
    const target = event.target as Element;
    const button = target.closest<HTMLElement>(
      "[data-share-copy], [data-share-native]",
    );
    const root = button?.closest("[data-share]");
    if (!button || !root) return;

    const url = button.dataset.url ?? "";
    const title = button.dataset.title ?? "";

    if (button.hasAttribute("data-share-copy")) {
      await copyLink(root, url);
      return;
    }

    try {
      await navigator.share({ title, url });
    } catch (error) {
      // The reader closed the share sheet: nothing to do.
      if (error instanceof DOMException && error.name === "AbortError") return;
      await copyLink(root, url);
    }
  });

  document.addEventListener("astro:page-load", () => {
    if (!("share" in navigator)) return;
    for (const button of document.querySelectorAll<HTMLElement>(
      "[data-share-native]",
    )) {
      button.hidden = false;
    }
  });
</script>

<style>
  .share {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6em;
  }

  /* Stay centered under the title when the row wraps on narrow screens. */
  .share.top {
    justify-content: center;
  }

  .share-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4em;
    min-width: 2.6em;
    height: 2.6em;
    padding: 0 0.75em;
    font: inherit;
    font-size: 0.95em;
    font-weight: 600;
    color: var(--color-text);
    background: var(--color-surface);
    border: none;
    border-radius: 999px;
    box-shadow: var(--shadow);
    text-decoration: none;
    cursor: pointer;
    transition:
      transform 0.15s,
      color 0.15s;
  }

  .share-btn[hidden],
  .copied-text[hidden] {
    display: none;
  }

  .share-btn:hover {
    transform: translateY(-1px);
    color: var(--accent);
  }

  .share-btn:active {
    transform: scale(0.96);
  }

  .share-btn:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .filled {
    fill: currentColor;
  }

  .stroked {
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  @media (prefers-reduced-motion: reduce) {
    .share-btn {
      transition: none;
    }
  }
</style>
