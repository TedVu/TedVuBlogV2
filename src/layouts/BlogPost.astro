---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import LikeButton from "../components/LikeButton.vue";
import ShareButtons from "../components/ShareButtons.astro";

const { title, description, publishedDate, heroImage, image } = Astro.props;
// "/blog/my-slug/" -> "blog/my-slug"
const postKey = Astro.url.pathname.replace(/^\/|\/$/g, "");
const isPost = /^(blog|viet)\/[^/]+$/.test(postKey);
const isViet = postKey.startsWith("viet/");
// Same value BaseHead uses for the canonical link and og:url.
const canonicalURL = new URL(Astro.url.pathname, Astro.site).href;

// Contentful posts pass `image`; /viet/ posts fall back to their hero image.
const previewImage =
  image ??
  (isViet && heroImage
    ? { url: new URL(heroImage, Astro.site).href, alt: title }
    : undefined);
---

<html lang="en" data-theme="dark" transition:name="root">
  <head>
    <BaseHead
      title={title}
      description={description}
      image={previewImage}
      type={isPost ? "article" : "website"}
      locale={isViet ? "vi_VN" : "en_US"}
    />
    <style>
      main {
        width: 80%;
        margin: auto;
      }
      .hero-image {
        width: 100%;
      }
      .hero-image img {
        width: 60%;
        display: block;
        margin: 0 auto;
        border-radius: 12px;
        box-shadow: var(--shadow);
      }
      .prose {
        width: 720px;
        max-width: calc(100% - 2em);
        margin: auto;
        padding: 1em;
        color: var(--color-text);
      }
      .title {
        margin-bottom: 1em;
        padding: 1em 0;
        text-align: center;
        line-height: 1;
      }
      .title h1 {
        margin: 0 0 0.5em 0;
      }
      .date {
        margin-bottom: 0.5em;
        color: var(--color-muted);
      }
      .last-updated-on {
        font-style: italic;
      }
      .post-actions {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 1em;
      }
      .post-actions.top {
        justify-content: center;
        margin-top: 1em;
      }
      .post-actions.bottom {
        margin-top: 2.5em;
        padding-top: 1.5em;
        border-top: 1px solid rgba(0, 0, 0, 0.12);
      }
    </style>
  </head>

  <body>
    <Header />
    <main>
      <article>
        <div class="hero-image">
          {heroImage && <img src={heroImage} alt="" />}
        </div>
        <div class="prose">
          <div class="title">
            <h1>{title}</h1>
            <div>{publishedDate}</div>
            {
              isPost && (
                <div class="post-actions top">
                  <LikeButton client:load postKey={postKey} position="top" />
                  <ShareButtons url={canonicalURL} title={title} position="top" />
                </div>
              )
            }
            <hr />
          </div>
          <slot />
          {
            isPost && (
              <div class="post-actions bottom">
                <LikeButton client:visible postKey={postKey} />
                <ShareButtons url={canonicalURL} title={title} position="bottom" />
              </div>
            )
          }
        </div>
      </article>
    </main>
    <Footer />
  </body>
</html>
